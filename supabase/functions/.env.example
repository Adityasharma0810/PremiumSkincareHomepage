# Local-only Edge Function environment template.
# Copy to supabase/functions/.env for local `supabase functions serve`.
# For deployment, configure these in Supabase Edge Function Secrets instead.
# Never prefix server secrets with VITE_ or expose them to the browser.

# Use the matching test or live key pair. Live credentials process real payments.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# DTDC customer softdata upload uses https://app.shipsy.in.
# Configure DTDC_API_KEY as a Supabase Edge Function secret; never expose it to Vite.
DTDC_API_KEY=
DTDC_CUSTOMER_CODE=
DTDC_SERVICE_TYPE_ID=
DTDC_HUB_CODE=
DTDC_SENDER_NAME=
DTDC_SENDER_PHONE=
DTDC_SENDER_ADDRESS_LINE1=
DTDC_SENDER_ADDRESS_LINE2=
DTDC_SENDER_CITY=
DTDC_SENDER_STATE=
DTDC_SENDER_PINCODE=
DTDC_SENDER_COUNTRY=India
DTDC_PARCEL_WEIGHT_KG=
DTDC_PARCEL_LENGTH_CM=
DTDC_PARCEL_WIDTH_CM=
DTDC_PARCEL_HEIGHT_CM=
# JSON array supplied by DTDC/Shipsy with courier_partner, courier_accounts,
# mode (shipment or bag), and node_type (FM/MM/LM). Declared value is set per order.
DTDC_ROUTE_NODES_JSON=
