# Local-only Edge Function environment template.
# Copy to supabase/functions/.env for local `supabase functions serve`.
# For deployment, configure these in Supabase Edge Function Secrets instead.
# Never prefix server secrets with VITE_ or expose them to the browser.

# Use the matching test or live key pair. Live credentials process real payments.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Create a Shiprocket API user in Settings > API and use its credentials here.
# These are server-only secrets; never expose them to Vite or the browser.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact pickup-location alias from the Shiprocket account and its 6-digit PIN code.
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Fully packed outer parcel dimensions and weight; configure in cm and kg.
SHIPROCKET_PARCEL_WEIGHT_KG=
SHIPROCKET_PARCEL_LENGTH_CM=
SHIPROCKET_PARCEL_WIDTH_CM=
SHIPROCKET_PARCEL_HEIGHT_CM=
