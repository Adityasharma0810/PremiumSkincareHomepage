# Supabase connection secrets for the derma aura skincare storefront.
# Copy this file to `.env` and fill in your values from the Supabase dashboard
# (Project Settings → API).

# Found at: Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Found at: Project Settings → API → Project API keys → anon/public key
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Razorpay credentials are NOT Vite variables. Configure them as Supabase
# Edge Function secrets (use rzp_test_ keys while testing):
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=...
# Then deploy the backend function:
#   supabase functions deploy razorpay
# Never expose the secret key in this file or browser code.
